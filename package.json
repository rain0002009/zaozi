{
  "name": "hanzi-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:routes": "node --experimental-strip-types --test scripts/route-generation.test.mjs",
    "test:riddle": "node --experimental-strip-types --test scripts/riddle-stele.test.mjs",
    "test:crafting": "node --experimental-strip-types --test scripts/riddle-crafting.test.mjs",
    "test:sanctuary": "node --experimental-strip-types --test scripts/sanctuary-trial.test.mjs",
    "test:motion": "node --experimental-strip-types --test scripts/character-motion.test.mjs",
    "test:attack-motion": "node --experimental-strip-types --test scripts/character-attack-motion.test.mjs",
    "test:rig": "node --experimental-strip-types --test scripts/character-rig.test.mjs",
    "test:rig:browser": "node scripts/verify-character-rig.cjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
